/**
 * @defgroup dstm_version "dstm Version Management"
 * @brief dstm library Version.
 * @{
 **/

#ifndef DSTM_VERSION_H
#define DSTM_VERSION_H 1

/**
 * dstm Major version (compilation time value).
 * Major version changes in dstm
 * denotes ABI changes which prevent
 * compatibility with previous major version ABI.
 *
 **/
#define	DSTM_VERSION_MAJOR @PACKAGE_VERSION_MAJOR@

/**
 * dstm Minor version (compilation time value).
 * dstm ABI is compatible across increasing minor
 * versions.
 * New minor versions should only bring new features
 * or improvement without breaking the old ABI.
 **/
#define	DSTM_VERSION_MINOR @PACKAGE_VERSION_MINOR@

/**
 * dstm Patch version (compilation time value).
 * dstm version for patch and fix releases.
 **/
#define	DSTM_VERSION_PATCH @PACKAGE_VERSION_PATCH@

/**
 * dstm revision version (compilation time value)
 * dstm revision (git drift since last tag), used
 * for identifying major drift since release.
 **/
#define DSTM_VERSION_REVISION "@PACKAGE_VERSION_REVISION@"

/**
 * dstm version as string.
 * "major.minor.patch"
 **/
#define	DSTM_VERSION_STRING "@PACKAGE_VERSION@"

/**
 * dstm Major version (runtime value).
 * If runtime value and compilation value do not
 * match, either the wrong library is linked or
 * the program has been compiled with the wrong header.
 * @see DSTM_VERSION_MAJOR
 **/
extern const int dstm_version_major;

/**
 * dstm Minor version (runtime value).
 * If runtime value and compilation value do not
 * match, either the wrong library is linked or
 * the program has been compiled with the wrong header.
 * @see DSTM_VERSION_MINOR
 **/
extern const int dstm_version_minor;

/**
 * dstm Patch version (runtime value).
 * If runtime value and compilation value do not
 * match, either the wrong library is linked or
 * the program has been compiled with the wrong header.
 * @see DSTM_VERSION_PATCH
 **/
extern const int dstm_version_patch;

/**
 * dstm revision as string (runtime value).
 * If runtime value and compilation value do not
 * match, either the wrong library is linked or
 * the program has been compiled with the wrong header.
 * @see DSTM_VERSION_REVISION
 **/
extern const char *dstm_version_revision;

/**
 * dstm version as string (runtime value).
 * If runtime value and compilation value do not
 * match, either the wrong library is linked or
 * the program has been compiled with the wrong header.
 * @see DSTM_VERSION_STRING
 **/
extern const char *dstm_version_string;

/**
 * @}
 **/

#endif /* DSTM_VERSION_H */
