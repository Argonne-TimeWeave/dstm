#!/bin/bash -l
#PBS -N dstm-scaling
#PBS -A timeweave
#PBS -q prod
#PBS -l select=10:ncpus=64
#PBS -l place=scatter
#PBS -l walltime=01:30:00
#PBS -l filesystems=home:eagle
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"

module purge
module load PrgEnv-gnu
module unload craype-accel-nvidia80 2>/dev/null || true
module unload darshan 2>/dev/null || true

export PATH="${HOME}/sst/bin:${PATH}"
export LD_LIBRARY_PATH="${HOME}/sst/lib:${LD_LIBRARY_PATH:-}"
export MPICH_GPU_SUPPORT_ENABLED=0

ROOT="$(cd "${PBS_O_WORKDIR}/.." && pwd)"

for d in sst opt_sst; do
    (
        cd "${ROOT}/${d}"
        CC $(sst-config --ELEMENT_CXXFLAGS) -O2 -std=c++17 -fPIC -shared \
            -o libopt_dcbench.so datacenter.cc $(sst-config --ELEMENT_LDFLAGS)
        sst-register opt_dcbench "opt_dcbench_LIBDIR=${ROOT}/${d}"
    )
done

sst-info opt_dcbench >/dev/null

export MPIRUN=/opt/cray/pals/1.8/bin/mpiexec
export MAX_WORKER_NODES=8
export MAX_PPN=32
export TREE_FANOUT=16

export REPEATS=2
export STEPS=1000
export STRONG_RACKS=512
export STRONG_JOBS=32768
export WEAK_RACKS_PER_RANK=8
export WEAK_JOBS_PER_RANK=512

./scaling.sh both

cp results/scaling.csv results/16polaris.csv
